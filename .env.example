# ---- Run mode -------------------------------------------------------------
# replay: deterministic demo from committed fixtures, no API key required.
# live:   real LLM calls through an OpenAI-compatible endpoint.
DEMO_MODE=live

# ---- LLM (live mode only) ---------------------------------------------------
# Recommended live setup fills all credential groups in this file:
# LLM_API_KEY, QIANFAN_API_KEY, and LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY.
# Provider preset: dashscope | siliconflow | custom
#   dashscope   -> https://dashscope.aliyuncs.com/compatible-mode/v1 (default model: qwen-plus)
#   siliconflow -> https://api.siliconflow.cn/v1 (default model: deepseek-ai/DeepSeek-V3)
#   custom      -> set OPENAI_BASE_URL + MODEL_NAME yourself
LLM_PROVIDER=custom
OPENAI_BASE_URL=https://api.deepseek.com
# Required for live LLM calls. Replace in local .env only; never commit secrets.
LLM_API_KEY=<hidden>
MODEL_NAME=deepseek-v4-pro
DEFAULT_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=600
MAX_REPAIR_ATTEMPTS=2
# DeepSeek official API: max_tokens limits the total generated output.
# Keep enough budget for strict JSON responses on long resumes.
LLM_MAX_OUTPUT_TOKENS=32768

# ---- Upload & Privacy Contract ---------------------------------------------
MAX_RESUMES=5
MAX_FILE_MB=5

# ---- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///data/recruiting.db

# ---- Langfuse (optional; app degrades to local logs/ledger when disabled) ----
ENABLE_LANGFUSE=true
# Recommended for hosted traces. Replace in local .env only; never commit secrets.
LANGFUSE_PUBLIC_KEY=<hidden>
LANGFUSE_SECRET_KEY=<hidden>
# Must match the region where your project was created:
#   EU: https://cloud.langfuse.com
#   US: https://us.cloud.langfuse.com
#   JP: https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# ---- Cost estimate (USD per 1K tokens; model-dependent estimate only) ----
COST_INPUT_PER_1K=0.0008
COST_OUTPUT_PER_1K=0.002

# ---- 百度千帆 PaddleOCR-VL（勿提交 git）--------------------------------------
# Recommended for scanned PDF OCR. Replace in local .env only; never commit secrets.
QIANFAN_API_KEY=<hidden>

# ---- UI ----------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
# Developer-only replay button in the launcher. Keep hidden for normal reviewers/users.
VITE_SHOW_REPLAY_DEMO=false
